{
  "mcp": {
    "servers": {
      "drizzle": {
        "type": "local",
        "command": [
          "pnpm",
          "--filter",
          "web",
          "exec",
          "drizzle-kit",
          "mcp"
        ]
      },
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "shadcn@latest",
          "mcp"
        ],
        "cwd": "apps/web"
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ],
        "environment": {}
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
