{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GOOGLE_GENAI_API_KEY",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "VOCHAI_API_KEY",
    "VOCHAI_BASE_URL",
    "VOCHAI_TOKEN"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
