{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "GENIECHAT_PROVIDER",
    "GOOGLE_GENAI_API_KEY",
    "GOOGLE_GENAI_USE_VERTEXAI",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "OPENAI_API_KEY",
    "GPT_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "GPT_MODEL",
    "GOOGLE_CLOUD_PROJECT",
    "GOOGLE_CLOUD_LOCATION",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "GOOGLE_APPLICATION_CREDENTIALS_JSON",
    "K_SERVICE",
    "FUNCTION_TARGET",
    "GAE_SERVICE",
    "CLOUD_RUN_JOB",
    "VOCHAI_API_KEY",
    "VOCHAI_BASE_URL",
    "VOCHAI_TOKEN",
    "DATABASE_URL",
    "AZURE_STORAGE_CONNECTION_STRING",
    "AZURE_STORAGE_CONTAINER"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
