# Required for DB-backed scenario content and value banks
DATABASE_URL=

# LLM provider selection
# - "gemini" (default) uses GOOGLE_GENAI_API_KEY or GEMINI_API_KEY
# - "openai" uses OPENAI_API_KEY (or GPT_API_KEY)
GENIECHAT_PROVIDER=gemini

# Gemini / Google GenAI
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Vertex mode (usually false on Vercel)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# OpenAI fallback/alternative
OPENAI_API_KEY=
GPT_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GPT_MODEL=

# Speech transcription (Vochai)
VOCHAI_API_KEY=
VOCHAI_TOKEN=
VOCHAI_BASE_URL=https://aui-transcription-api.fly.dev/api/v1

# Optional: Azure Blob (not currently required by runtime chat route)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=audio
