# LLM provider selection for GenieChat
# gemini | openai
GENIECHAT_PROVIDER=gemini

# Local development (recommended for Gemini): API key mode
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_API_KEY=your-api-key

# Gemini Enterprise / Vertex AI alternative
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Temporary GPT/OpenAI provider (set GENIECHAT_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Neon Postgres (content DB: lessons, grammar, vocabulary, audio metadata) ---
# Create a project at https://neon.tech, then copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Azure Blob Storage (audio files; DB stores container + storage key only) ---
# Create a storage account → Containers → "audio" with anonymous read access,
# then copy the account's connection string.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=audio
AZURE_STORAGE_ACCOUNT=your-storage-account-name
