# LLM provider selection for GenieChat
# gemini | openai
GENIECHAT_PROVIDER=gemini

# Local development (recommended for Gemini): API key mode
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_API_KEY=your-api-key

# Gemini Enterprise / Vertex AI alternative
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Temporary GPT/OpenAI provider (set GENIECHAT_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
